# Copier vers .env puis remplacer le mot de passe par une valeur aleatoire forte.
POSTGRES_DB=orga_alfiya
POSTGRES_USER=orga_alfiya
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_LONG_ET_ALEATOIRE

# N'exposer que la facade web sur la boucle locale du NAS.
ORGA_HTTP_BIND=127.0.0.1
ORGA_HTTP_PORT=8092

# Bloc 2 - Authentification (remplacer par votre adresse d'administration).
SUPERADMIN_EMAIL=admin@example.com
ORGA_PUBLIC_URL=https://orga-alfiya.amvei.synology.me
COOKIE_SECURE=true

# SMTP pour invitations et liens de connexion. Secrets UNIQUEMENT dans le .env local.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=REMPLACER_SECRET_SMTP
SMTP_FROM=admin@example.com

# Bloc 7 - Push HTTPS. Générer une clé P-256 sur le NAS, hors GitHub.
# mkdir -p secrets && openssl ecparam -name prime256v1 -genkey -noout -out secrets/vapid_private.pem
VAPID_PRIVATE_KEY_FILE=/app/secrets/vapid_private.pem
VAPID_CONTACT=mailto:admin@example.com
