# Copier vers .env puis remplacer le mot de passe par une valeur aleatoire forte.
POSTGRES_DB=orga_alfiya
POSTGRES_USER=orga_alfiya
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_LONG_ET_ALEATOIRE

# N'exposer que la facade web sur la boucle locale du NAS.
ORGA_HTTP_BIND=127.0.0.1
ORGA_HTTP_PORT=8092
